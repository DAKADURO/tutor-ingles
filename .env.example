OPENAI_API_KEY=pega_aqui_tu_api_key
PORT=3000

# Codigo que los usuarios deben ingresar para entrar a la app.
# Si se deja vacio, la app queda abierta sin proteccion (solo para desarrollo local).
APP_ACCESS_CODE=elige_un_codigo_secreto

# Para enviar el correo cuando alguien solicita acceso (Gmail + contrasena de aplicacion).
# Genera una en https://myaccount.google.com/apppasswords
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion
# Correo donde quieres recibir las solicitudes (por defecto, GMAIL_USER)
NOTIFY_EMAIL=tu_correo@gmail.com
